# a2a-switchboard plugin — secrets for ~/.hermes/.env
#
# Copy the lines you need into ~/.hermes/.env (git-ignored, never commit).
# Everything here is credential-shaped; NOTHING secret belongs in settings.yaml.
#
# The non-secret parts (gateway URLs, peer name) live in the plugin's
# settings.yaml under plugins.entries.a2a-switchboard.settings.gateways.

# ── Gateway / registration tokens ────────────────────────────────────────
# One entry per switchboard, semicolon-separated. `name` is the alias used
# in settings.yaml `gateways[].name`. The token value is a board-issued
# gateway token (→ peer lands in the pending queue, admin accepts you) or
# bootstrap token (→ auto-accepted).
#
#   A2A_SWITCHBOARD_TOKENS=name=fleet:token=agw_fleet_token_here;name=dev:token=agw_dev_token_here
A2A_SWITCHBOARD_TOKENS=

# ── Upstream token (yours, one value shared by all boards) ───────────────
# The token the switchboard presents AS YOU when it proxies fleet calls to
# your inbound A2A server — i.e. it must be accepted by YOUR gateway's
# inbound auth (A2A_PEER_TOKENS / A2A_BEARER_TOKEN in ~/.hermes/.env).
# The reverse channel uses the same value when forwarding delivered
# requests to 127.0.0.1:<A2A_PORT>.
A2A_SWITCHBOARD_UPSTREAM_TOKEN=

# ── Per-board caller tokens (OPTIONAL — auto-managed) ────────────────────
# Minted by each board on first registration and persisted automatically to
# ~/.hermes/a2a-switchboard/caller_tokens.json (mode 0600). Pre-seed only if
# migrating an existing caller_token. Same name=value;name=value shape.
#   A2A_SWITCHBOARD_CALLER_TOKENS=name=fleet:token=agw_...
A2A_SWITCHBOARD_CALLER_TOKENS=
