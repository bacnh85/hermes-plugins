# b2-backup plugin — secrets for ~/.hermes/.env (copy the values, keep .env 0600)
#
# Backblaze B2 (create an application key limited to ONE bucket — least privilege):
#   B2_ACCOUNT_ID       = the account's keyID shown on the App Keys page
#   B2_APPLICATION_KEY  = the applicationKey itself
#   B2_BUCKET           = bucket name (e.g. hlab-prod-backup)
#
# Encryption: restic encrypts client-side with RESTIC_PASSWORD before anything
# leaves this machine. B2 stores only ciphertext. LOSE THE PASSWORD = LOSE THE
# BACKUPS. Store it in your password manager too.

B2_ACCOUNT_ID=<your b2 keyID>
B2_APPLICATION_KEY=<your b2 applicationKey>
B2_BUCKET=hlab-prod-backup
RESTIC_PASSWORD=<long-random-passphrase>
